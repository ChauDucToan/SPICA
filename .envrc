# Optional per-machine override.
source_env_if_exists .envrc.local

# Auto-detect ROCm laptop, otherwise use the regular PC environment.
if [[ -z "${SPICA_VENV:-}" ]]; then
  if [[ -e /dev/kfd && -x ".venv-rocm/bin/python" ]]; then
    export SPICA_VENV=".venv-rocm"
  else
    export SPICA_VENV=".venv"
  fi
fi

venv_path="$(expand_path "$SPICA_VENV")"

if [[ ! -x "$venv_path/bin/python" ]]; then
  echo "SPICA environment not found: $venv_path" >&2
  return 1
fi

export VIRTUAL_ENV="$venv_path"
unset PYTHONHOME
PATH_add "$VIRTUAL_ENV/bin"

if [[ "$SPICA_VENV" == ".venv-rocm" ]]; then
  export HSA_OVERRIDE_GFX_VERSION="10.3.0"
  export PYTORCH_ROCM_ARCH="gfx1030"

  # GPU 0 = RX 6500M 4 GB; GPU 1 = integrated Radeon 0.5 GB.
  export HIP_VISIBLE_DEVICES="0"
fi

export UV_PROJECT_ENVIRONMENT="$SPICA_VENV"

if [[ "$SPICA_VENV" == ".venv-rocm" ]]; then
  export SPICA_ACCELERATOR="rocm"
else
  export SPICA_ACCELERATOR="cuda"
fi

# Expose the NixOS NVIDIA driver libraries to non-Nix Python wheels.
if [[ "$SPICA_ACCELERATOR" == "cuda" && -d /run/opengl-driver/lib ]]; then
  export LD_LIBRARY_PATH="/run/opengl-driver/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
